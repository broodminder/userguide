USER=USERNAME
OPENAI_API_KEY=OPENAI_API_KEY
BUILD_ONLY_LOCALE=en
ENABLE_PDF_EXPORT=0

# Ask BroodMinder (0 = classic search [default], 1 = chat). Loaded by build.sh via source.
# No inline comments on the same line as the value.
ENABLE_DOC_ASSISTANT=0
# Widget → API URL (Mac Mini / Tailscale) — only needed when ENABLE_DOC_ASSISTANT=1
DOC_ASSISTANT_API=